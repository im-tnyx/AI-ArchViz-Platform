{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-archviz.example/schema/scene-change-set-v0.3.schema.json",
  "title": "AI ArchViz SceneChangeSet v0.3 — deterministic revision subset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "changeSetId",
    "projectId",
    "sceneId",
    "baseRevisionId",
    "targetRevisionId",
    "requestedBy",
    "source",
    "intent",
    "riskLevel",
    "operations",
    "preconditions",
    "metadata"
  ],
  "properties": {
    "schemaVersion": { "const": "0.3.0" },
    "changeSetId": { "$ref": "#/$defs/id" },
    "projectId": { "$ref": "#/$defs/id" },
    "sceneId": { "$ref": "#/$defs/id" },
    "baseRevisionId": { "$ref": "#/$defs/id" },
    "targetRevisionId": { "$ref": "#/$defs/id" },
    "requestedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["user", "system", "worker", "operator"] },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "referenceIds"],
      "properties": {
        "type": { "enum": ["manual_edit", "system_repair"] },
        "referenceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "intent": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "riskLevel": { "enum": ["low", "medium", "high"] },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/moveObject" },
          { "$ref": "#/$defs/updateOpening" },
          { "$ref": "#/$defs/assignMaterial" },
          { "$ref": "#/$defs/lockProperty" },
          { "$ref": "#/$defs/unlockProperty" },
          { "$ref": "#/$defs/replaceAsset" },
          { "$ref": "#/$defs/setRenderIntent" },
          { "$ref": "#/$defs/addLight" },
          { "$ref": "#/$defs/migrateMaterialAppearanceContract" },
          { "$ref": "#/$defs/setCamera" }
        ]
      }
    },
    "preconditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/precondition" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt"],
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 3,
      "maxLength": 128
    },
    "vector3": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "positiveVector3": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "rotationEuler", "scale"],
      "properties": {
        "position": { "$ref": "#/$defs/vector3" },
        "rotationEuler": { "$ref": "#/$defs/vector3" },
        "scale": { "$ref": "#/$defs/positiveVector3" }
      }
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetId"],
      "properties": {
        "type": { "enum": ["ObjectExists", "TransformUnlocked"] },
        "targetId": { "$ref": "#/$defs/id" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "field"],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/id" },
        "field": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "moveObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "type",
        "targetId",
        "reason",
        "riskLevel",
        "parameters",
        "preconditions",
        "provenance",
        "expectedImpact"
      ],
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "type": { "const": "MoveObject" },
        "targetId": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "riskLevel": { "const": "low" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transform"],
          "properties": { "transform": { "$ref": "#/$defs/transform" } }
        },
        "preconditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/precondition" }
        },
        "provenance": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenance" }
        },
        "expectedImpact": { "$ref": "#/$defs/expectedImpact" }
      }
    },
    "updateOpening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "type",
        "targetId",
        "reason",
        "riskLevel",
        "parameters",
        "preconditions",
        "provenance",
        "expectedImpact"
      ],
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "type": { "const": "UpdateOpening" },
        "targetId": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "riskLevel": { "const": "high" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["offset", "width", "sill", "height"],
          "properties": {
            "offset": { "type": "number", "minimum": 0 },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "sill": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "preconditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/precondition" }
        },
        "provenance": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenance" }
        },
        "expectedImpact": { "$ref": "#/$defs/expectedImpact" }
      }
    },
    "assignMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "type",
        "targetId",
        "reason",
        "riskLevel",
        "parameters",
        "preconditions",
        "provenance",
        "expectedImpact"
      ],
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "type": { "const": "AssignMaterial" },
        "targetId": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "riskLevel": { "const": "medium" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["materialId"],
          "properties": {
            "materialId": { "$ref": "#/$defs/id" }
          }
        },
        "preconditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/precondition" }
        },
        "provenance": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenance" }
        },
        "expectedImpact": { "$ref": "#/$defs/expectedImpact" }
      }
    },
    "lockProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "type",
        "targetId",
        "reason",
        "riskLevel",
        "parameters",
        "preconditions",
        "provenance",
        "expectedImpact"
      ],
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "type": { "const": "LockProperty" },
        "targetId": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "riskLevel": { "const": "medium" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["propertyPath"],
          "properties": {
            "propertyPath": { "$ref": "#/$defs/propertyLockPath" }
          }
        },
        "preconditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/precondition" }
        },
        "provenance": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenance" }
        },
        "expectedImpact": { "$ref": "#/$defs/expectedImpact" }
      }
    },
    "unlockProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "type",
        "targetId",
        "reason",
        "riskLevel",
        "parameters",
        "preconditions",
        "provenance",
        "expectedImpact"
      ],
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "type": { "const": "UnlockProperty" },
        "targetId": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "riskLevel": { "const": "medium" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["propertyPath"],
          "properties": {
            "propertyPath": { "$ref": "#/$defs/propertyLockPath" }
          }
        },
        "preconditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/precondition" }
        },
        "provenance": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenance" }
        },
        "expectedImpact": { "$ref": "#/$defs/expectedImpact" }
      }
    },
    "replaceAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "type",
        "targetId",
        "reason",
        "riskLevel",
        "parameters",
        "preconditions",
        "provenance",
        "expectedImpact"
      ],
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "type": { "const": "ReplaceAsset" },
        "targetId": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "riskLevel": { "const": "medium" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["newAssetDefinitionId", "placementPolicy"],
          "properties": {
            "newAssetDefinitionId": { "$ref": "#/$defs/id" },
            "placementPolicy": { "const": "preserve_anchor" }
          }
        },
        "preconditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/precondition" }
        },
        "provenance": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenance" }
        },
        "expectedImpact": { "$ref": "#/$defs/expectedImpact" }
      }
    },
    "setRenderIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "type",
        "targetId",
        "reason",
        "riskLevel",
        "parameters",
        "preconditions",
        "provenance",
        "expectedImpact"
      ],
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "type": { "const": "SetRenderIntent" },
        "targetId": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "riskLevel": { "const": "medium" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "mode"],
          "properties": {
            "engine": { "const": "corona" },
            "mode": { "const": "preview" }
          }
        },
        "preconditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/precondition" }
        },
        "provenance": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenance" }
        },
        "expectedImpact": { "$ref": "#/$defs/expectedImpact" }
      }
    },
    "addLight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "type",
        "targetId",
        "reason",
        "riskLevel",
        "parameters",
        "preconditions",
        "provenance",
        "expectedImpact"
      ],
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "type": { "const": "AddLight" },
        "targetId": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "riskLevel": { "const": "medium" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["light"],
          "properties": {
            "light": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type", "transform", "intensity"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "type": { "const": "area" },
                "transform": { "$ref": "#/$defs/transform" },
                "intensity": { "type": "number", "minimum": 0 }
              }
            }
          }
        },
        "preconditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/precondition" }
        },
        "provenance": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenance" }
        },
        "expectedImpact": { "$ref": "#/$defs/expectedImpact" }
      }
    },
    "migrateMaterialAppearanceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "type",
        "targetId",
        "reason",
        "riskLevel",
        "parameters",
        "preconditions",
        "provenance",
        "expectedImpact"
      ],
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "type": { "const": "MigrateMaterialAppearanceContract" },
        "targetId": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "riskLevel": { "const": "high" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targetSceneSpecVersion", "materials"],
          "properties": {
            "targetSceneSpecVersion": { "const": "0.3.0" },
            "materials": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/materialAppearanceEntry" }
            }
          }
        },
        "preconditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/precondition" }
        },
        "provenance": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenance" }
        },
        "expectedImpact": { "$ref": "#/$defs/expectedImpact" }
      }
    },
    "materialAppearanceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materialId", "roughness", "metalness"],
      "properties": {
        "materialId": { "$ref": "#/$defs/id" },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "metalness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "setCamera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "type",
        "targetId",
        "reason",
        "riskLevel",
        "parameters",
        "preconditions",
        "provenance",
        "expectedImpact"
      ],
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "type": { "const": "SetCamera" },
        "targetId": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "riskLevel": { "const": "medium" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "target", "orientationPolicy", "focalLengthMm", "sensorWidthMm"],
          "properties": {
            "position": { "$ref": "#/$defs/vector3" },
            "target": { "$ref": "#/$defs/vector3" },
            "orientationPolicy": { "const": "look_at_target" },
            "focalLengthMm": { "type": "number", "exclusiveMinimum": 0 },
            "sensorWidthMm": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "preconditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/precondition" }
        },
        "provenance": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenance" }
        },
        "expectedImpact": { "$ref": "#/$defs/expectedImpact" }
      }
    },
    "propertyLockPath": {
      "enum": ["geometry", "transform", "material"]
    },
    "expectedImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["affectedLogicalIds"],
      "properties": {
        "affectedLogicalIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      }
    }
  }
}
