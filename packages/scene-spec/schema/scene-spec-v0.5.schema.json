{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-archviz.example/schema/scene-spec-v0.5.schema.json",
  "title": "AI ArchViz SceneSpec v0.5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sceneSpecVersion",
    "project",
    "scene",
    "coordinateSystem",
    "sources",
    "levels",
    "spaces",
    "geometry",
    "openings",
    "assetDefinitions",
    "assets",
    "cameras",
    "render",
    "revisions",
    "extensions",
    "circulationRequirements"
  ],
  "properties": {
    "sceneSpecVersion": {
      "const": "0.5.0"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "scene": {
      "$ref": "#/$defs/scene"
    },
    "coordinateSystem": {
      "$ref": "#/$defs/coordinateSystem"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/level"
      }
    },
    "spaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/space"
      }
    },
    "geometry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/wall"
          },
          {
            "$ref": "#/$defs/surface"
          },
          {
            "$ref": "#/$defs/sharedPartition"
          }
        ]
      }
    },
    "openings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/doorOpening"
          },
          {
            "$ref": "#/$defs/windowOpening"
          },
          {
            "$ref": "#/$defs/partitionDoorOpening"
          }
        ]
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "assetDefinitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assetDefinition"
      }
    },
    "materials": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/material"
      }
    },
    "materialAssignments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/materialAssignment"
      }
    },
    "lights": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/light"
      }
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/camera"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "render": {
      "$ref": "#/$defs/renderIntent"
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/revision"
      }
    },
    "extensions": {
      "type": "object",
      "description": "Only explicit extension namespace. Extension keys must be vendor-qualified.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": true
    },
    "circulationRequirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/circulationRequirement"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 3,
      "maxLength": 128
    },
    "vector3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "positiveVector3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "rotationEuler",
        "scale"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "rotationEuler": {
          "$ref": "#/$defs/vector3"
        },
        "scale": {
          "$ref": "#/$defs/positiveVector3"
        }
      }
    },
    "identityTransform": {
      "const": {
        "position": [
          0,
          0,
          0
        ],
        "rotationEuler": [
          0,
          0,
          0
        ],
        "scale": [
          1,
          1,
          1
        ]
      }
    },
    "locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry",
        "transform",
        "material"
      ],
      "properties": {
        "geometry": {
          "type": "boolean"
        },
        "transform": {
          "type": "boolean"
        },
        "material": {
          "type": "boolean"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revisionId",
        "headRevisionId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "revisionId": {
          "$ref": "#/$defs/id"
        },
        "headRevisionId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linearUnit",
        "angularUnit",
        "upAxis",
        "handedness",
        "axisConvention",
        "worldOrigin"
      ],
      "properties": {
        "linearUnit": {
          "const": "mm"
        },
        "angularUnit": {
          "const": "degree"
        },
        "upAxis": {
          "const": "Z"
        },
        "handedness": {
          "const": "right"
        },
        "axisConvention": {
          "const": "X_east_Y_north_Z_up"
        },
        "worldOrigin": {
          "$ref": "#/$defs/vector3"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "uri",
        "authority",
        "confidence",
        "verified"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "synthetic_fixture",
            "dwg",
            "dxf",
            "pdf",
            "image",
            "max"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "enum": [
            "A0",
            "A1",
            "A2",
            "A3",
            "A4",
            "A5"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "elevation",
        "defaultCeilingHeight"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "elevation": {
          "type": "number"
        },
        "defaultCeilingHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "levelId",
        "type",
        "boundary",
        "boundaryWinding",
        "floorElevation",
        "ceilingHeight",
        "transform"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "levelId": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "living_room",
            "bedroom",
            "dining_room",
            "generic"
          ]
        },
        "boundary": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/vector3"
          }
        },
        "boundaryWinding": {
          "const": "counter_clockwise"
        },
        "floorElevation": {
          "type": "number"
        },
        "ceilingHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "transform": {
          "$ref": "#/$defs/identityTransform"
        }
      }
    },
    "wall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "levelId",
        "spaceId",
        "start",
        "end",
        "baseElevation",
        "height",
        "thickness",
        "referenceLine",
        "thicknessDirection",
        "transform",
        "locks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "wall"
        },
        "levelId": {
          "$ref": "#/$defs/id"
        },
        "spaceId": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "$ref": "#/$defs/vector3"
        },
        "end": {
          "$ref": "#/$defs/vector3"
        },
        "baseElevation": {
          "type": "number"
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "referenceLine": {
          "const": "interior_face"
        },
        "thicknessDirection": {
          "const": "exterior_right_of_u"
        },
        "transform": {
          "$ref": "#/$defs/identityTransform"
        },
        "locks": {
          "$ref": "#/$defs/locks"
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "levelId",
        "spaceId",
        "boundary",
        "elevation",
        "thickness",
        "extrusionDirection",
        "transform",
        "locks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "floor",
            "ceiling"
          ]
        },
        "levelId": {
          "$ref": "#/$defs/id"
        },
        "spaceId": {
          "$ref": "#/$defs/id"
        },
        "boundary": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/vector3"
          }
        },
        "elevation": {
          "type": "number"
        },
        "thickness": {
          "type": "number",
          "minimum": 0
        },
        "extrusionDirection": {
          "enum": [
            "none",
            "up",
            "down"
          ]
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "locks": {
          "$ref": "#/$defs/locks"
        }
      }
    },
    "doorOpening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "hostGeometryId",
        "offset",
        "width",
        "sill",
        "height",
        "hingeSide",
        "swingDirection",
        "transform",
        "locks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "door"
        },
        "hostGeometryId": {
          "$ref": "#/$defs/id"
        },
        "offset": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sill": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hingeSide": {
          "enum": [
            "start_jamb",
            "end_jamb"
          ]
        },
        "swingDirection": {
          "enum": [
            "into_room",
            "out_of_room"
          ]
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "locks": {
          "$ref": "#/$defs/locks"
        }
      }
    },
    "windowOpening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "hostGeometryId",
        "offset",
        "width",
        "sill",
        "height",
        "transform",
        "locks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "window"
        },
        "hostGeometryId": {
          "$ref": "#/$defs/id"
        },
        "offset": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sill": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "locks": {
          "$ref": "#/$defs/locks"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "assetDefinitionId",
        "spaceId",
        "transform",
        "locks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "proxy_asset"
        },
        "assetDefinitionId": {
          "$ref": "#/$defs/id"
        },
        "spaceId": {
          "$ref": "#/$defs/id"
        },
        "hostGeometryId": {
          "$ref": "#/$defs/id"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "locks": {
          "$ref": "#/$defs/locks"
        }
      }
    },
    "assetDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "category",
        "sourceType",
        "dimensions",
        "pivotPolicy",
        "allowNonUniformScale"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "category": {
          "enum": [
            "sofa",
            "coffee_table",
            "tv_unit",
            "generic_proxy"
          ]
        },
        "sourceType": {
          "enum": [
            "procedural_proxy",
            "external_max"
          ]
        },
        "artifactId": {
          "$ref": "#/$defs/id"
        },
        "dimensions": {
          "$ref": "#/$defs/positiveVector3"
        },
        "pivotPolicy": {
          "enum": [
            "floor_center",
            "back_center_floor"
          ]
        },
        "allowNonUniformScale": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceType": {
                "const": "external_max"
              }
            }
          },
          "then": {
            "properties": {
              "artifactId": {}
            },
            "required": [
              "artifactId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "sourceType": {
                "const": "procedural_proxy"
              }
            }
          },
          "then": {
            "properties": {
              "artifactId": {}
            },
            "not": {
              "required": [
                "artifactId"
              ]
            }
          }
        }
      ]
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "baseColorRgb",
        "roughness",
        "metalness"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "baseColorRgb": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metalness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "materialAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "targetId",
        "materialId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "targetId": {
          "$ref": "#/$defs/id"
        },
        "materialId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "transform",
        "intensity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "point",
            "directional",
            "area"
          ]
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "intensity": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "spaceId",
        "transform",
        "target",
        "orientationPolicy",
        "focalLengthMm",
        "sensorWidthMm"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "camera"
        },
        "spaceId": {
          "$ref": "#/$defs/id"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "target": {
          "$ref": "#/$defs/vector3"
        },
        "orientationPolicy": {
          "const": "look_at_target"
        },
        "focalLengthMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sensorWidthMm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceId",
        "role",
        "applyTo"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "sourceId": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "geometry_authority",
            "design_reference"
          ]
        },
        "applyTo": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "subjectId",
        "targetId",
        "severity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "inside_boundary",
            "hosted_by",
            "no_duplicate_id"
          ]
        },
        "subjectId": {
          "$ref": "#/$defs/id"
        },
        "targetId": {
          "$ref": "#/$defs/id"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        }
      }
    },
    "renderIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "mode"
      ],
      "properties": {
        "engine": {
          "enum": [
            "none",
            "corona",
            "vray"
          ]
        },
        "mode": {
          "enum": [
            "build_only",
            "preview",
            "final"
          ]
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revisionId",
        "parentRevisionId",
        "status",
        "createdAt"
      ],
      "properties": {
        "revisionId": {
          "$ref": "#/$defs/id"
        },
        "parentRevisionId": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "const": "committed"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "point2": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "circulationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "spaceId",
        "evaluationPolicy",
        "start",
        "end"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "same_space_route"
        },
        "spaceId": {
          "$ref": "#/$defs/id"
        },
        "evaluationPolicy": {
          "const": "circulation-policy-v0.2"
        },
        "start": {
          "$ref": "#/$defs/circulationEndpoint"
        },
        "end": {
          "$ref": "#/$defs/circulationEndpoint"
        }
      }
    },
    "circulationEndpoint": {
      "oneOf": [
        {
          "$ref": "#/$defs/circulationDoorPortalEndpoint"
        },
        {
          "$ref": "#/$defs/circulationPointEndpoint"
        }
      ]
    },
    "circulationDoorPortalEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "openingId"
      ],
      "properties": {
        "kind": {
          "const": "door_portal"
        },
        "openingId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "circulationPointEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "pointXY"
      ],
      "properties": {
        "kind": {
          "const": "point"
        },
        "pointXY": {
          "$ref": "#/$defs/point2"
        }
      }
    },
    "partitionSpaceFace": {
      "type": "object",
      "description": "The physical face of a shared partition on one adjacent space's side: the centerline offset by thickness/2 along that side's normal, in the same start -> end direction as the centerline.",
      "additionalProperties": false,
      "required": [
        "spaceId",
        "side",
        "start",
        "end"
      ],
      "properties": {
        "spaceId": {
          "$ref": "#/$defs/id"
        },
        "side": {
          "enum": [
            "left",
            "right"
          ]
        },
        "start": {
          "$ref": "#/$defs/vector3"
        },
        "end": {
          "$ref": "#/$defs/vector3"
        }
      }
    },
    "sharedPartition": {
      "type": "object",
      "description": "One physical partition shared by exactly two spaces (sorted adjacentSpaceIds). start -> end is the reviewed CENTERLINE; u = normalize(end - start), leftNormal = [-u.y, u.x], rightNormal = [u.y, -u.x]; the body is thickness wide centered on it. spaceFaces lists the left face then the right face.",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "levelId",
        "adjacentSpaceIds",
        "start",
        "end",
        "baseElevation",
        "height",
        "thickness",
        "referenceLine",
        "spaceFaces",
        "transform",
        "locks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "shared_partition"
        },
        "levelId": {
          "$ref": "#/$defs/id"
        },
        "adjacentSpaceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "start": {
          "$ref": "#/$defs/vector3"
        },
        "end": {
          "$ref": "#/$defs/vector3"
        },
        "baseElevation": {
          "type": "number"
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "referenceLine": {
          "const": "centerline"
        },
        "spaceFaces": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "$ref": "#/$defs/partitionSpaceFace",
              "properties": {
                "side": {
                  "const": "left"
                }
              }
            },
            {
              "type": "object",
              "$ref": "#/$defs/partitionSpaceFace",
              "properties": {
                "side": {
                  "const": "right"
                }
              }
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "transform": {
          "$ref": "#/$defs/identityTransform"
        },
        "locks": {
          "$ref": "#/$defs/locks"
        }
      }
    },
    "partitionDoorOpening": {
      "type": "object",
      "description": "A door hosted on a shared_partition, connecting exactly the host's two spaces. offset is measured along the partition centerline start -> end. hingeEndpoint names the jamb (host_start = lower offset, host_end = offset + width); swingIntoSpaceId is one of connectsSpaceIds. Windows are never partition-hosted in v0.5.",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "hostGeometryId",
        "connectsSpaceIds",
        "offset",
        "width",
        "sill",
        "height",
        "hingeEndpoint",
        "swingIntoSpaceId",
        "transform",
        "locks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "door"
        },
        "hostGeometryId": {
          "$ref": "#/$defs/id"
        },
        "connectsSpaceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "offset": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sill": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hingeEndpoint": {
          "enum": [
            "host_start",
            "host_end"
          ]
        },
        "swingIntoSpaceId": {
          "$ref": "#/$defs/id"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "locks": {
          "$ref": "#/$defs/locks"
        }
      }
    }
  },
  "description": "SceneSpec v0.5: SceneSpec v0.4 plus canonical multi-space semantics. A shared_partition is ONE physical partition shared by exactly two spaces, referenced on its reviewed centerline with explicit left/right space faces; a partition-hosted door connects exactly those two spaces with an explicit hinge endpoint and swing space. Regular walls keep their single-space interior_face semantics. Space boundaries remain the reviewed reference boundaries (never rewritten to partition faces). Circulation requirements pin circulation-policy-v0.2."
}
