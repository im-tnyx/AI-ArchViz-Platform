{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-archviz.example/schema/asset-inspection-v0.1.schema.json",
  "title": "AI ArchViz trusted external asset inspection evidence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inspectionVersion",
    "artifactId",
    "artifactSha256",
    "inspector",
    "dcc",
    "result",
    "findings"
  ],
  "properties": {
    "inspectionVersion": { "const": "0.1.0" },
    "artifactId": { "$ref": "#/$defs/id" },
    "artifactSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "inspector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version"],
      "properties": {
        "type": { "const": "trusted_3ds_max_asset_inspector" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "dcc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "testedMajorVersion", "compatibilityMode"],
      "properties": {
        "product": { "const": "3ds_max" },
        "testedMajorVersion": { "type": "integer", "minimum": 1, "maximum": 9999 },
        "compatibilityMode": { "type": "boolean" }
      }
    },
    "result": { "enum": ["pass", "fail"] },
    "failureCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "minLength": 3,
      "maxLength": 128
    },
    "findings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene", "geometry", "units", "materials", "dependencies", "security"],
      "properties": {
        "scene": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeCount", "geometryNodeCount", "cameraCount", "lightCount"],
          "properties": {
            "nodeCount": { "type": "integer", "minimum": 0 },
            "geometryNodeCount": { "type": "integer", "minimum": 0 },
            "cameraCount": { "type": "integer", "minimum": 0 },
            "lightCount": { "type": "integer", "minimum": 0 }
          }
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["worldBoundingBoxMm", "dimensionsMm", "pivotPositionMm", "floorCenterAnchorCompatible"],
          "properties": {
            "worldBoundingBoxMm": { "$ref": "#/$defs/vector6" },
            "dimensionsMm": { "$ref": "#/$defs/vector3NonNegative" },
            "pivotPositionMm": { "$ref": "#/$defs/vector3" },
            "floorCenterAnchorCompatible": { "type": "boolean" }
          }
        },
        "units": {
          "type": "object",
          "additionalProperties": false,
          "required": ["systemType", "systemScale", "displayType", "normalization", "useFileUnits"],
          "properties": {
            "systemType": { "type": "string", "minLength": 1, "maxLength": 80 },
            "systemScale": { "type": "number", "exclusiveMinimum": 0 },
            "displayType": { "type": "string", "minLength": 1, "maxLength": 80 },
            "normalization": { "const": "millimeters" },
            "useFileUnits": { "const": true }
          }
        },
        "materials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["materialCount", "classNames"],
          "properties": {
            "materialCount": { "type": "integer", "minimum": 0 },
            "classNames": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["missingExternalFiles", "missingDLLs", "xrefs", "externalReferenceCount"],
          "properties": {
            "missingExternalFiles": { "type": "integer", "minimum": 0 },
            "missingDLLs": { "type": "integer", "minimum": 0 },
            "xrefs": { "type": "integer", "minimum": 0 },
            "externalReferenceCount": { "type": "integer", "minimum": 0 }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "required": ["safeSceneScriptExecutionEnabled", "settingsLocked", "lockCause", "scriptAssetsProtected"],
          "properties": {
            "safeSceneScriptExecutionEnabled": { "type": "boolean" },
            "settingsLocked": { "type": "boolean" },
            "lockCause": { "type": "string", "minLength": 1, "maxLength": 64 },
            "scriptAssetsProtected": { "type": "boolean" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 3,
      "maxLength": 128
    },
    "vector3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "vector3NonNegative": {
      "type": "array",
      "items": { "type": "number", "minimum": 0 },
      "minItems": 3,
      "maxItems": 3
    },
    "vector6": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 6,
      "maxItems": 6
    }
  }
}
