{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-archviz.example/schema/corona-material-appearance-evidence-v0.1.schema.json",
  "title": "Corona canonical material appearance evidence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidenceVersion", "renderer", "dcc", "safeScene", "materials", "materialAssignments", "deduplication", "status"],
  "properties": {
    "evidenceVersion": { "const": "0.1.0" },
    "renderer": {
      "type": "object", "additionalProperties": false, "required": ["engine", "className", "version"],
      "properties": { "engine": { "const": "corona" }, "className": { "type": "string", "minLength": 1, "maxLength": 256 }, "version": { "type": ["string", "null"], "maxLength": 256 } }
    },
    "dcc": {
      "type": "object", "additionalProperties": false, "required": ["product", "version", "compatibilityMode"],
      "properties": { "product": { "const": "3ds_max" }, "version": { "type": "string", "minLength": 1, "maxLength": 256 }, "compatibilityMode": { "type": "boolean" } }
    },
    "safeScene": {
      "type": "object", "additionalProperties": false,
      "required": ["safeSceneScriptExecutionEnabled", "settingsLocked", "lockCause", "scriptAssetsProtected"],
      "properties": {
        "safeSceneScriptExecutionEnabled": { "const": true },
        "settingsLocked": { "const": true },
        "lockCause": { "const": "cmdline" },
        "scriptAssetsProtected": { "const": true }
      }
    },
    "materials": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/materialAppearance" } },
    "materialAssignments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assignment" } },
    "deduplication": {
      "type": "object", "additionalProperties": false,
      "required": ["sameIdSharedInstance", "differentIdDistinctInstances"],
      "properties": {
        "sameIdSharedInstance": { "const": true },
        "differentIdDistinctInstances": { "const": true }
      }
    },
    "status": { "const": "PASS" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "minLength": 3, "maxLength": 128 },
    "rgb": { "type": "array", "prefixItems": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "number", "minimum": 0, "maximum": 1 }, { "type": "number", "minimum": 0, "maximum": 1 }], "items": false, "minItems": 3, "maxItems": 3 },
    "materialAppearance": {
      "type": "object", "additionalProperties": false,
      "required": [
        "materialId",
        "actualClass",
        "canonicalBaseColorRgb",
        "canonicalRoughness",
        "canonicalMetalness",
        "observedBaseColorRgb",
        "observedRoughness",
        "observedMetalness",
        "materialInstanceName"
      ],
      "properties": {
        "materialId": { "$ref": "#/$defs/id" },
        "actualClass": { "type": "string", "minLength": 1, "maxLength": 256 },
        "canonicalBaseColorRgb": { "$ref": "#/$defs/rgb" },
        "canonicalRoughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "canonicalMetalness": { "type": "number", "minimum": 0, "maximum": 1 },
        "observedBaseColorRgb": { "$ref": "#/$defs/rgb" },
        "observedRoughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "observedMetalness": { "type": "number", "minimum": 0, "maximum": 1 },
        "materialInstanceName": { "type": "string", "pattern": "^AVZ_CORONA_[A-Za-z0-9_]+$", "maxLength": 180 }
      }
    },
    "assignment": {
      "type": "object", "additionalProperties": false,
      "required": ["targetId", "materialId", "materialInstanceName", "className", "sharedMaterialInstance"],
      "properties": {
        "targetId": { "$ref": "#/$defs/id" },
        "materialId": { "$ref": "#/$defs/id" },
        "materialInstanceName": { "type": "string", "pattern": "^AVZ_CORONA_[A-Za-z0-9_]+$", "maxLength": 180 },
        "className": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sharedMaterialInstance": { "const": true }
      }
    }
  }
}
