{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-archviz.example/schema/canonical-material-state-v0.1.schema.json",
  "title": "AI ArchViz Canonical Material State Evidence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "materialStateVersion",
    "projectId",
    "sceneId",
    "revisionId",
    "sceneSpecVersion",
    "materials",
    "materialAssignments",
    "deduplication",
    "status"
  ],
  "properties": {
    "materialStateVersion": { "const": "0.1.0" },
    "projectId": { "$ref": "#/$defs/id" },
    "sceneId": { "$ref": "#/$defs/id" },
    "revisionId": { "$ref": "#/$defs/id" },
    "sceneSpecVersion": { "const": "0.3.0" },
    "materials": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/materialState" } },
    "materialAssignments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assignmentState" }
    },
    "deduplication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sameIdSharedInstance", "differentIdDistinctInstances"],
      "properties": {
        "sameIdSharedInstance": { "const": true },
        "differentIdDistinctInstances": { "const": true }
      }
    },
    "status": { "const": "PASS" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "minLength": 3, "maxLength": 128 },
    "rgb": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "minimum": 0, "maximum": 1 }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "materialState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialId",
        "actualClass",
        "canonicalBaseColorRgb",
        "observedBaseColorRgb",
        "canonicalRoughness",
        "observedRoughness",
        "canonicalMetalness",
        "observedMetalness",
        "materialInstanceName"
      ],
      "properties": {
        "materialId": { "$ref": "#/$defs/id" },
        "actualClass": { "type": "string", "minLength": 1, "maxLength": 256 },
        "canonicalBaseColorRgb": { "$ref": "#/$defs/rgb" },
        "observedBaseColorRgb": { "$ref": "#/$defs/rgb" },
        "canonicalRoughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "observedRoughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "canonicalMetalness": { "type": "number", "minimum": 0, "maximum": 1 },
        "observedMetalness": { "type": "number", "minimum": 0, "maximum": 1 },
        "materialInstanceName": {
          "type": "string",
          "pattern": "^AVZ_MATERIAL_[A-Za-z0-9_]+$",
          "maxLength": 180
        }
      }
    },
    "assignmentState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "materialId", "materialInstanceName"],
      "properties": {
        "targetId": { "$ref": "#/$defs/id" },
        "materialId": { "$ref": "#/$defs/id" },
        "materialInstanceName": {
          "type": "string",
          "pattern": "^AVZ_MATERIAL_[A-Za-z0-9_]+$",
          "maxLength": 180
        }
      }
    }
  }
}
