{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-archviz.example/schema/golden-corona-preview-plan-v0.1.schema.json",
  "title": "Golden Corona diagnostic preview plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["planVersion", "engine", "intentSource", "profileId", "source", "materials", "materialAssignments", "camera", "temporaryLight", "render", "adapterDefaults"],
  "properties": {
    "planVersion": { "const": "0.1.0" },
    "engine": { "const": "corona" },
    "intentSource": { "const": "trusted_diagnostic_profile" },
    "profileId": { "const": "golden_living_corona_preview_v1" },
    "source": { "$ref": "#/$defs/source" },
    "materials": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/material" } },
    "materialAssignments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assignment" } },
    "camera": { "$ref": "#/$defs/camera" },
    "temporaryLight": { "$ref": "#/$defs/light" },
    "render": { "$ref": "#/$defs/render" },
    "adapterDefaults": { "$ref": "#/$defs/defaults" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "minLength": 3, "maxLength": 128 },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "vector3": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }], "items": false, "minItems": 3, "maxItems": 3 },
    "rgb": { "type": "array", "prefixItems": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "number", "minimum": 0, "maximum": 1 }, { "type": "number", "minimum": 0, "maximum": 1 }], "items": false, "minItems": 3, "maxItems": 3 },
    "source": { "type": "object", "additionalProperties": false, "required": ["projectId", "sceneId", "revisionId", "sceneSpecHash", "artifactHash"], "properties": { "projectId": { "const": "project_golden_living_001" }, "sceneId": { "const": "scene_golden_living_001" }, "revisionId": { "const": "rev_golden_0008" }, "sceneSpecHash": { "$ref": "#/$defs/hash" }, "artifactHash": { "$ref": "#/$defs/hash" } } },
    "material": { "type": "object", "additionalProperties": false, "required": ["materialId", "baseColorRgb"], "properties": { "materialId": { "$ref": "#/$defs/id" }, "baseColorRgb": { "$ref": "#/$defs/rgb" } } },
    "assignment": { "type": "object", "additionalProperties": false, "required": ["assignmentId", "targetId", "materialId"], "properties": { "assignmentId": { "$ref": "#/$defs/id" }, "targetId": { "$ref": "#/$defs/id" }, "materialId": { "$ref": "#/$defs/id" } } },
    "camera": { "type": "object", "additionalProperties": false, "required": ["logicalId", "position", "target", "focalLengthMm", "sensorWidthMm", "fovRadians"], "properties": { "logicalId": { "const": "camera_living_a" }, "position": { "$ref": "#/$defs/vector3" }, "target": { "$ref": "#/$defs/vector3" }, "focalLengthMm": { "const": 24 }, "sensorWidthMm": { "const": 36 }, "fovRadians": { "type": "number", "exclusiveMinimum": 0, "maximum": 3.141592653589793 } } },
    "light": { "type": "object", "additionalProperties": false, "required": ["logicalId", "type", "position", "rotationEuler", "canonicalIntensity", "mappedIntensity", "widthMm", "executionOnlyName"], "properties": { "logicalId": { "const": "preview_key_area" }, "type": { "const": "area" }, "position": { "$ref": "#/$defs/vector3" }, "rotationEuler": { "$ref": "#/$defs/vector3" }, "canonicalIntensity": { "const": 1.25 }, "mappedIntensity": { "const": 150 }, "widthMm": { "const": 800 }, "executionOnlyName": { "const": "AVZ_PREVIEW_CORONA_KEY" } } },
    "render": { "type": "object", "additionalProperties": false, "required": ["mode", "resolution", "termination"], "properties": { "mode": { "const": "preview" }, "resolution": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "const": 320 }, "height": { "const": 240 } } }, "termination": { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "pass_limit" }, "value": { "const": 4 } } } } },
    "defaults": { "type": "object", "additionalProperties": false, "required": ["material", "areaLight"], "properties": { "material": { "type": "object", "additionalProperties": false, "required": ["roughness", "nonMetalMode"], "properties": { "roughness": { "const": 0.45 }, "nonMetalMode": { "const": true } } }, "areaLight": { "type": "object", "additionalProperties": false, "required": ["widthMm", "intensityScale"], "properties": { "widthMm": { "const": 800 }, "intensityScale": { "const": 120 } } } } }
  }
}
