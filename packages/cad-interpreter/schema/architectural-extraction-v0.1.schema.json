{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-archviz.example/schema/architectural-extraction-v0.1.schema.json",
  "title": "AI ArchViz architectural extraction v0.1",
  "description": "Deterministic architectural CANDIDATES derived from cad-document-v0.1 under an explicit interpretation profile, awaiting human review. Not SceneSpec; candidate IDs are not canonical logical IDs. All lengths in millimeters; no paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["architecturalExtractionVersion", "interpretationPolicyVersion", "profileId", "profileHash", "source", "canonicalUnits", "level", "spaces", "walls", "openings", "unconsumedEntities", "summary", "status"],
  "properties": {
    "architecturalExtractionVersion": { "const": "0.1.0" },
    "interpretationPolicyVersion": { "const": "cad-interpretation-policy-v0.1" },
    "profileId": { "$ref": "#/$defs/id" },
    "profileHash": { "$ref": "#/$defs/hash" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cadDocumentVersion", "sourceFormat", "sourceHash", "cadDocumentHash"],
      "properties": {
        "cadDocumentVersion": { "const": "0.1.0" },
        "sourceFormat": { "const": "dxf" },
        "sourceHash": { "$ref": "#/$defs/hash" },
        "cadDocumentHash": { "$ref": "#/$defs/hash" }
      }
    },
    "canonicalUnits": { "const": "millimeters" },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["levelCandidateId", "name", "elevationMm", "defaultCeilingHeightMm", "provenance"],
      "properties": {
        "levelCandidateId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "elevationMm": { "type": "number" },
        "defaultCeilingHeightMm": { "$ref": "#/$defs/positiveMm" },
        "provenance": { "$ref": "#/$defs/provenanceMap", "required": ["name", "elevationMm", "defaultCeilingHeightMm"], "propertyNames": { "enum": ["name", "elevationMm", "defaultCeilingHeightMm"] } }
      }
    },
    "spaces": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/space" } },
    "walls": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/wall" } },
    "openings": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/door" }, { "$ref": "#/$defs/window" }] } },
    "unconsumedEntities": { "type": "array", "items": { "$ref": "#/$defs/unconsumedEntity" } },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spaceCount", "wallCount", "openingCount", "doorCount", "windowCount", "sourceEntityCount", "consumedEntityCount", "unconsumedEntityCount"],
      "properties": {
        "spaceCount": { "$ref": "#/$defs/count" },
        "wallCount": { "$ref": "#/$defs/count" },
        "openingCount": { "$ref": "#/$defs/count" },
        "doorCount": { "$ref": "#/$defs/count" },
        "windowCount": { "$ref": "#/$defs/count" },
        "sourceEntityCount": { "$ref": "#/$defs/count" },
        "consumedEntityCount": { "$ref": "#/$defs/count" },
        "unconsumedEntityCount": { "$ref": "#/$defs/count" }
      }
    },
    "status": { "const": "READY_FOR_REVIEW" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "minLength": 3, "maxLength": 128 },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "count": { "type": "integer", "minimum": 0 },
    "positiveMm": { "type": "number", "exclusiveMinimum": 0 },
    "point2": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "sourceOrdinal", "sourceHandle", "role"],
          "properties": {
            "authority": { "const": "cad" },
            "sourceOrdinal": { "$ref": "#/$defs/count" },
            "sourceHandle": { "type": ["string", "null"] },
            "role": { "enum": ["space_boundary", "space_label", "door_insert", "window_insert"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "field", "ruleId"],
          "properties": {
            "authority": { "const": "profile" },
            "field": { "type": "string", "minLength": 1 },
            "ruleId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "derivation"],
          "properties": {
            "authority": { "const": "derived" },
            "derivation": { "type": "string", "pattern": "^[a-z][a-z0-9_]*_v0\\.1$" }
          }
        }
      ]
    },
    "provenanceMap": {
      "type": "object",
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/provenance" } }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "levelCandidateId", "spaceType", "labelText", "boundary", "boundaryWinding", "sourceWinding", "normalization", "floorElevationMm", "ceilingHeightMm", "provenance"],
      "properties": {
        "candidateId": { "type": "string", "pattern": "^space_candidate_[0-9]{4}$" },
        "levelCandidateId": { "$ref": "#/$defs/id" },
        "spaceType": { "$ref": "#/$defs/id" },
        "labelText": { "type": "string", "minLength": 1 },
        "boundary": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point2" } },
        "boundaryWinding": { "const": "counter_clockwise" },
        "sourceWinding": { "enum": ["counter_clockwise", "clockwise"] },
        "normalization": { "enum": ["none", "reversed_to_counter_clockwise"] },
        "floorElevationMm": { "type": "number" },
        "ceilingHeightMm": { "$ref": "#/$defs/positiveMm" },
        "provenance": { "$ref": "#/$defs/provenanceMap", "required": ["boundary", "spaceType", "floorElevationMm", "ceilingHeightMm"], "propertyNames": { "enum": ["boundary", "spaceType", "floorElevationMm", "ceilingHeightMm"] } }
      }
    },
    "wall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "spaceCandidateId", "levelCandidateId", "edgeIndex", "start", "end", "lengthMm", "baseElevationMm", "heightMm", "thicknessMm", "referenceLine", "thicknessDirection", "provenance"],
      "properties": {
        "candidateId": { "type": "string", "pattern": "^wall_candidate_[0-9]{4}_[0-9]{4}$" },
        "spaceCandidateId": { "type": "string", "pattern": "^space_candidate_[0-9]{4}$" },
        "levelCandidateId": { "$ref": "#/$defs/id" },
        "edgeIndex": { "$ref": "#/$defs/count" },
        "start": { "$ref": "#/$defs/point2" },
        "end": { "$ref": "#/$defs/point2" },
        "lengthMm": { "$ref": "#/$defs/positiveMm" },
        "baseElevationMm": { "type": "number" },
        "heightMm": { "$ref": "#/$defs/positiveMm" },
        "thicknessMm": { "$ref": "#/$defs/positiveMm" },
        "referenceLine": { "const": "interior_face" },
        "thicknessDirection": { "const": "exterior_right_of_u" },
        "provenance": { "$ref": "#/$defs/provenanceMap", "required": ["geometry", "baseElevationMm", "heightMm", "thicknessMm", "referenceConvention"], "propertyNames": { "enum": ["geometry", "baseElevationMm", "heightMm", "thicknessMm", "referenceConvention"] } }
      }
    },
    "openingBase": {
      "type": "object",
      "required": ["candidateId", "type", "hostWallCandidateId", "spaceCandidateId", "blockName", "sourceCenter", "sourceRotationDegrees", "hostDistanceMm", "offsetMm", "widthMm", "heightMm", "sillMm", "provenance"],
      "properties": {
        "candidateId": { "type": "string", "pattern": "^opening_candidate_[0-9]{4}$" },
        "hostWallCandidateId": { "type": "string", "pattern": "^wall_candidate_[0-9]{4}_[0-9]{4}$" },
        "spaceCandidateId": { "type": "string", "pattern": "^space_candidate_[0-9]{4}$" },
        "blockName": { "type": "string", "minLength": 1 },
        "sourceCenter": { "$ref": "#/$defs/point2" },
        "sourceRotationDegrees": { "type": "number" },
        "hostDistanceMm": { "type": "number", "minimum": 0, "maximum": 1 },
        "offsetMm": { "type": "number", "minimum": 0 },
        "widthMm": { "$ref": "#/$defs/positiveMm" },
        "heightMm": { "$ref": "#/$defs/positiveMm" },
        "sillMm": { "type": "number", "minimum": 0 }
      }
    },
    "door": {
      "allOf": [{ "$ref": "#/$defs/openingBase" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["hingeSide", "swingDirection"],
      "properties": {
        "type": { "const": "door" },
        "sillMm": { "const": 0 },
        "hingeSide": { "enum": ["start_jamb", "end_jamb"] },
        "swingDirection": { "enum": ["into_room", "out_of_room"] },
        "provenance": { "$ref": "#/$defs/provenanceMap", "required": ["center", "host", "offsetMm", "widthMm", "heightMm", "sillMm", "hingeSide", "swingDirection"], "propertyNames": { "enum": ["center", "host", "offsetMm", "widthMm", "heightMm", "sillMm", "hingeSide", "swingDirection"] } }
      }
    },
    "window": {
      "allOf": [{ "$ref": "#/$defs/openingBase" }],
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "window" },
        "provenance": { "$ref": "#/$defs/provenanceMap", "required": ["center", "host", "offsetMm", "widthMm", "heightMm", "sillMm"], "propertyNames": { "enum": ["center", "host", "offsetMm", "widthMm", "heightMm", "sillMm"] } }
      }
    },
    "unconsumedEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceOrdinal", "sourceHandle", "type", "layer", "reason"],
      "properties": {
        "sourceOrdinal": { "$ref": "#/$defs/count" },
        "sourceHandle": { "type": ["string", "null"] },
        "type": { "type": "string", "minLength": 1 },
        "layer": { "type": "string", "minLength": 1 },
        "reason": { "enum": ["UNMAPPED_LAYER", "UNSUPPORTED_SOURCE_ENTITY"] }
      }
    }
  }
}
