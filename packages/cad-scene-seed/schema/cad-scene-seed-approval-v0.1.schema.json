{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-archviz.example/schema/cad-scene-seed-approval-v0.1.schema.json",
  "title": "AI ArchViz CAD scene seed approval v0.1",
  "description": "Declarative human approval of one exact architectural-extraction-v0.1 (bound by hash), with explicit canonical identity, candidate-to-logical-ID mappings, and non-CAD scene state. It never edits architectural facts: there is no override field anywhere.",
  "type": "object",
  "additionalProperties": false,
  "required": ["approvalVersion", "approvalId", "canonicalizationPolicy", "decision", "extraction", "canonical", "lockPolicy", "mappings", "nonCadState"],
  "properties": {
    "approvalVersion": { "const": "0.1.0" },
    "approvalId": { "$ref": "#/$defs/id" },
    "canonicalizationPolicy": { "const": "cad-scene-seed-policy-v0.1" },
    "decision": {
      "description": "Recorded review outcome. Only approved_as_is is canonicalizable in v0.1.",
      "enum": ["approved_as_is", "rejected", "changes_requested"]
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecturalExtractionVersion", "interpretationPolicyVersion", "profileId", "architecturalExtractionHash", "sourceHash", "cadDocumentHash", "profileHash"],
      "properties": {
        "architecturalExtractionVersion": { "const": "0.1.0" },
        "interpretationPolicyVersion": { "const": "cad-interpretation-policy-v0.1" },
        "profileId": { "$ref": "#/$defs/id" },
        "architecturalExtractionHash": { "$ref": "#/$defs/hash" },
        "sourceHash": { "$ref": "#/$defs/hash" },
        "cadDocumentHash": { "$ref": "#/$defs/hash" },
        "profileHash": { "$ref": "#/$defs/hash" }
      }
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "scene"],
      "properties": {
        "project": { "$ref": "https://ai-archviz.example/schema/scene-spec-v0.4.schema.json#/$defs/project" },
        "scene": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "revisionId", "createdAt"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "revisionId": { "$ref": "#/$defs/id" },
            "createdAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "lockPolicy": { "const": "all_unlocked" },
    "mappings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["levels", "spaces", "walls", "openings"],
      "properties": {
        "levels": { "type": "array", "items": { "$ref": "#/$defs/levelMapping" } },
        "spaces": { "type": "array", "items": { "$ref": "#/$defs/spaceMapping" } },
        "walls": { "type": "array", "items": { "$ref": "#/$defs/wallMapping" } },
        "openings": { "type": "array", "items": { "$ref": "#/$defs/openingMapping" } }
      }
    },
    "nonCadState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "assetDefinitions", "assets", "materials", "materialAssignments", "lights", "cameras", "render", "circulationRequirements"],
      "properties": {
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "https://ai-archviz.example/schema/scene-spec-v0.4.schema.json#/$defs/source" } },
        "assetDefinitions": { "type": "array", "items": { "$ref": "https://ai-archviz.example/schema/scene-spec-v0.4.schema.json#/$defs/assetDefinition" } },
        "assets": { "type": "array", "items": { "$ref": "https://ai-archviz.example/schema/scene-spec-v0.4.schema.json#/$defs/asset" } },
        "materials": { "type": "array", "items": { "$ref": "https://ai-archviz.example/schema/scene-spec-v0.4.schema.json#/$defs/material" } },
        "materialAssignments": { "type": "array", "items": { "$ref": "https://ai-archviz.example/schema/scene-spec-v0.4.schema.json#/$defs/materialAssignment" } },
        "lights": { "type": "array", "items": { "$ref": "https://ai-archviz.example/schema/scene-spec-v0.4.schema.json#/$defs/light" } },
        "cameras": { "type": "array", "items": { "$ref": "https://ai-archviz.example/schema/scene-spec-v0.4.schema.json#/$defs/camera" } },
        "render": { "$ref": "https://ai-archviz.example/schema/scene-spec-v0.4.schema.json#/$defs/renderIntent" },
        "circulationRequirements": { "type": "array", "items": { "$ref": "https://ai-archviz.example/schema/scene-spec-v0.4.schema.json#/$defs/circulationRequirement" } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "minLength": 3, "maxLength": 128 },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "levelMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "logicalId"],
      "properties": {
        "candidateId": { "$ref": "#/$defs/id" },
        "logicalId": { "$ref": "#/$defs/id" }
      }
    },
    "spaceMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "logicalId", "floorSurfaceId", "ceilingSurfaceId"],
      "properties": {
        "candidateId": { "type": "string", "pattern": "^space_candidate_[0-9]{4}$" },
        "logicalId": { "$ref": "#/$defs/id" },
        "floorSurfaceId": { "$ref": "#/$defs/id" },
        "ceilingSurfaceId": { "$ref": "#/$defs/id" }
      }
    },
    "wallMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "logicalId"],
      "properties": {
        "candidateId": { "type": "string", "pattern": "^wall_candidate_[0-9]{4}_[0-9]{4}$" },
        "logicalId": { "$ref": "#/$defs/id" }
      }
    },
    "openingMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "logicalId"],
      "properties": {
        "candidateId": { "type": "string", "pattern": "^opening_candidate_[0-9]{4}$" },
        "logicalId": { "$ref": "#/$defs/id" }
      }
    }
  }
}
